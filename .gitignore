# Secrets. Never commit real keys.
.env
.env.*
*.env
!.env.example
api key*.txt
*.pem
*.key
*.credentials.json

# NEAR credentials
.near-credentials/
near-credentials/

# Build output for spike and Rust workspaces
target/

# Local tooling
/.claude/

# Tests stay local; they are not part of the public repository.
/agents/tests/
/agents/scripts/test_*.py
/frontend/tests/
/contracts/tests/
/contracts/mock-dex/
/contracts/core/src/tests.rs

# Frontend design notes, static assets and agent instructions stay local.
/frontend/docs/
/frontend/public/
/frontend/AGENTS.md
/frontend/CLAUDE.md

# Data and models of assets outside the traded basket (written by research scripts).
/agents/data/apt_*
/agents/data/arb_*
/agents/data/ena_*
/agents/data/sei_*
/agents/data/tia_*
/agents/models/metadata.json

# Python bytecode
__pycache__/
*.pyc

