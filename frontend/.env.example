# Frontend env (copy to .env.local). NEAR values come from contracts/deployments/near_testnet.json.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_CORE_CONTRACT=
NEXT_PUBLIC_NEAR_TOKEN_CONTRACT=
NEXT_PUBLIC_NEAR_RPC_URL=
NEXT_PUBLIC_NEAR_FIRM_TOKEN_ID=
NEXT_PUBLIC_NEAR_BASE_TOKEN=wrap.testnet
NEXT_PUBLIC_NEAR_DEX_CONTRACT=ref-finance-101.testnet
NEXT_PUBLIC_NEAR_DEX_POOL_ID=
NEXT_PUBLIC_NEAR_ALLORA_CONTRACT=
# Supabase (new project) + the public URL of the agent service (Railway)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AGENT_URL=
# NEAR Agent Market landing page of the firm (leave empty until the listing is Live) and the executor account
NEXT_PUBLIC_AGENT_MARKET_URL=
NEXT_PUBLIC_NEAR_EXECUTOR_ACCOUNT=
# Public URL of this site (metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=
