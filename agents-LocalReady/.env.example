# ── agents-LocalReady · your local HeliQuant engine ──────────────────────────
# Copy this file to `.env`, then `docker compose up -d`.
#
# REQUIRED — your NEAR testnet account. Only this account may register keys through the web onboarding
# (POST /register): it signs a NEP-413 message with its full-access key in your wallet. Empty = /register off.
HQ_OWNER_ACCOUNT=yourname.testnet

# REQUIRED — the project's public repository (its agents/ folder is pulled into the engine). Keep as is
# unless you run your own fork.
HQ_REPO_URL=https://github.com/ChristianBagas123/HeliQuant.git

# Everything below is OPTIONAL here. The easiest path is to leave the keys blank and submit them through
# the web onboarding form on the HeliQuant dApp (/onboarding) — it POSTs them straight into THIS engine's
# local SQLite. Nothing leaves your machine either way.
#
# HQ_PROVIDER=groq                           # which LLM provider the desks use. Code default is openrouter, which
#                                            # fails without OPENROUTER_API_KEY; set groq when you only have Groq keys
# GROQ_API_KEY=gsk_xxx,gsk_yyy,gsk_zzz       # comma-separated — 10 free keys recommended
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_PASSPHRASE=
# BITGET_DEMO=1                              # 1 = demo (no real funds) · 0 = mainnet
# BITGET_EXECUTE=0                           # 1 = place real Bitget DEMO orders (BTC/ETH/XRP)
# NEAR_EXECUTOR_PRIVATE_KEY=                 # EXECUTOR_MODE=key only: limited function-call key on core (trade, anchor)
# NEAR_PARENT_ACCOUNT=heliquant.testnet      # EXECUTOR_MODE=key only: the key belongs to executor.<this account>
# NANSEN_API_KEY=
# ELFA_API_KEY=
# AGENT_MARKET_TOKEN=aat_...                # NEAR Agent Market agent token (market.near.ai); blank = worker off
# NEARAI_API_KEY=                            # NEAR AI Cloud key (TEE-signed LLM answers); use with HQ_PROVIDER=nearai
# NEARAI_BUDGET_USD=8                        # code-side spend guard for NEAR AI credits
# NEARAI_NO_THINK_LIGHT=1                    # 1 = operations and desks run on the main model (Qwen3.8-27B) with reasoning off
# NEARAI_DEBATE_MODEL=z-ai/glm-5.3-flash    # debate, PM and pm_signoff model (reasoning on, capped by a token budget); 'same' = main model
# NEARAI_THINK_OPEN=2000                     # reasoning token budget: debate openings (bull, bear)
# NEARAI_THINK_REBUT=1500                    # ... debate rebuttals
# NEARAI_THINK_PM=3000                       # ... portfolio manager
# NEARAI_THINK_SIGNOFF=500                   # ... pm_signoff
# NEARAI_DESK_WORKERS=4                      # desks run in parallel threads (1 = sequential)
# NEARAI_DESK_TIMEOUT_S=90                   # seconds to wait for one desk call
# NEARAI_TIMEOUT_S=240                       # seconds to wait for one NEAR AI answer (non-streaming)
# HQ_FALLBACK_PROVIDER=groq                  # used when the main provider fails or the budget is reached
# AGENT_LOOP=1                               # 0 = no automatic cycles (manual /run-cycle and Agent Market jobs still run)
# EXECUTOR_MODE=key                          # key = limited function-call key; custody = OutLayer wallet (no key in agent)
# OUTLAYER_API_KEY=wk_...                    # custody mode only
# OUTLAYER_WALLET_ACCOUNT=                   # custody mode only: 64-hex implicit account of the wallet

# Firm config (sensible defaults — override if you like)
ASSETS=BTC,ETH,SOL,HYPE,SUI,XRP
INTERVAL_MIN=30
REFRESH_DATA=1
